#!/usr/bin/env bash
# pre-commit: check-docs в блокирующем режиме (docs-sync блок 13).
# Ошибки → exit 1 (коммит отклоняется). Предупреждения не блокируют.
# Обход только осознанно: CHECK_DOCS_MODE=warn git commit …

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
export CHECK_DOCS_MODE="${CHECK_DOCS_MODE:-strict}"

echo "[pre-commit] check-docs (mode=$CHECK_DOCS_MODE)"
"$ROOT/code/scripts/check-docs.sh" || {
  echo "[pre-commit] check-docs: ошибки — коммит отклонён (блок 13)"
  exit 1
}
