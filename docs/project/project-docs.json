    "development": {
      "file_paths": {
        "rule": "В БД и UI путь хранится и показывается как в Проводнике пользователя. JVM при открытии файла переводит его в путь своей ОС; перевод в БД не пишется.",
        "windows_example": "D:\\wire-guard-share-nb-win\\femsq\\excel\\2025-12\\debit\\файл.xlsx",
        "wsl_runtime": "D:\\... → /mnt/d/... (плюс bind /mnt/nb-win-share для шары nb-win)",
        "resolver": "com.femsq.web.api.sudz.SudzDbtUplExcelPathResolver",
        "operator_responsibility": "Пользователь обеспечивает существование пути на машине процесса Java.",
        "accepted": "2026-08-14",
        "notes": "Linux-монтирование шары (/mnt/nb-win-share) остаётся для доступа к файлам с Fedora; это не форма хранения в БД."
      },
      "environments": {
