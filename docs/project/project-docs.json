        "type": "thin-jar",
        "build": "./code/scripts/build-thin-jar.sh (+ check-fequlib, +1 к 4-й цифре версии)",
        "run": "java -jar … с каталогом lib/ (см. run-with-external-libs.sh)"
      },
      "endpoints": {
        "app": "http://host:port/",
        "graphql": "/graphql",
        "health": "/api/v1/connection/status",
        "version": "/api/v1/app/version",
        "note": "Доменные REST /api/og|/api/ra|/api/ipg|/api/lookup удалены (docs-sync блок 5)"
      },
      "prod": {
        "machine": "prod-fisheye",
        "registry": "project.development.environments.machines.prod-fisheye",
        "sqlTarget": "SQL Server 2012 SP4 — только скрипты MSSQL2012/",
