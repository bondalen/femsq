# GraphQL API витрин СУДЗ (0067 read / 0068 write / портфель года CRUD).
# Источник: схема sudz на DEV (S48); на prod объекты будут в ags (S48a).

extend type Query {
  """Список год-вариантов СУДЗ с lookup-подписями."""
  sudzYears: [SudzYear!]!

  """Карточка год-варианта: шапка + выгрузки + pm-связи. Ошибка, если yr не найден."""
  sudzYear(yrKey: Int!): SudzYearDetail!

  """Lookup выгрузок ДЗ (upl_name + upl_date + uplStatusOnDate)."""
  sudzUplLookups: [SudzUplLookup!]!

  """Lookup групп комментариев (cnicgName + cnicgDate)."""
  sudzCmmGrLookups: [SudzCmmGrLookup!]!

  """Lookup календарных лет из ags.yyyy (yKey / yyyy)."""
  sudzYyyyLookups: [SudzYyyyLookup!]!

  """Lookup выгрузок платежей (cn_inv_pm_name + date)."""
  sudzPmUplLookups: [SudzPmUplLookup!]!

  """
  Портфель года в структуре Rslt (зерно dbtKey, срезы по дате выгрузки).
  asOfUpl — опционально: только срезы с upl_date ≤ даты выбранной выгрузки (Rslt сбор).
  Ошибка, если yr не найден.
  """
  sudzYrDbtChanges(yr: Int!, asOfUpl: Int): [SudzRsltDebt!]!

  """
  Итоговый документ D644 (база года vs текущая выгрузка).
  Ошибка, если yr не найден или currUpl некорректен на стороне БД.
  """
  sudzD644(yr: Int!, currUpl: Int!): [SudzD644Row!]!

  """Годовой свод по счетам ГК + строка ВСЕГО."""
  sudzD644Svod(yr: Int!, currUpl: Int!): SudzSvodResult!

  """
  Лаунчер загрузки свода (0069 / экран C): реестр upl + CnInvDbtUplFile/FileSh/InvDouble.
  Ошибка, если выгрузка не найдена.
  """
  sudzDbtUplLauncher(uplKey: Int!): SudzDbtUplLauncher!
  """Года-портфели, в которых upl входит в yr_upl_p (для контекста воронки)."""
  sudzYearKeysForUpl(uplKey: Int!): [Int!]!
  """Excel-кандидат КСДСФ по ключу очереди."""
  sudzSfDoubleExcelCandidate(ciusKey: Int!): SudzSfDoubleExcelCandidate
  """Excel-кандидат очереди двоящих долгов по ciudKey."""
  sudzInvDbtDoubleExcelCandidate(ciudKey: Int!): SudzSfDoubleExcelCandidate
  """Слоты invDbt по iKey (экран двоящих долгов)."""
  sudzInvDbtSlots(iKey: Int!): [SudzInvDbtSlot!]!
  """Кандидаты FK для create invDbtVar по строке очереди двоящих."""
  sudzInvDbtVarCandidates(ciudKey: Int!): SudzInvDbtVarCandidates!
  """Доменные СФ с совпадающим номером."""
  sudzSfDoubleDomainMatches(invNum: String!): [SudzSfDoubleDomainMatch!]!
  """
  Кандидаты вкладки «Суммы»: старая (cn_inv_dbt) и новая (DbtValue) структуры
  по сумме Excel ± epsilon (по умолчанию 0.01).
  """
  sudzSfDoubleSumMatches(debt: Float!, epsilon: Float): SudzSfDoubleSumMatches!
  """
  Подсказки КСДСФ: есть ли исполнитель Excel среди СФ по номеру и сумм (old/new).
  Ключи items — для выбора строки в таблицах экрана.
  """
  sudzSfDoubleHints(ciusKey: Int!, epsilon: Float): SudzSfDoubleHints!
  """Советник КСДСФ для панели «Сообщения» ([советник])."""
  sudzSfDoubleAdvice(ciusKey: Int!, epsilon: Float): SudzSfDoubleAdvice!
  """
  Советник КСДД (22c): рекомендация оператору для строки очереди двоящих долгов.
  """
  sudzInvDbtDoubleAdvice(ciudKey: Int!, epsilon: Float): SudzInvDbtDoubleAdvice!
  """
  Временной ряд DbtValue одного слота invDbt (вкладка «Динамика», выбранный слот).
  """
  sudzInvDbtSlotTimeline(iKey: Int!, idKey: Int!, ciudKey: Int!): SudzInvDbtSlotTimeline!
  """Поиск канонов Dbt (S78): фильтры по var / idNum / dbtKey."""
  searchSudzDbtCanons(input: SudzDbtCanonSearchInput!): [SudzDbtCanonCandidate!]!
  """Карточка канона Dbt со слотами и Value (S78)."""
  sudzDbtCanon(dbtKey: Int!): SudzDbtCanonDetail!
}

extend type Mutation {
  """Создать год-вариант (существующая база upl ИЛИ inline-создание выгрузки)."""
  createSudzYear(input: CreateSudzYearInput!): SudzYearDetail!

  """Обновить год-вариант (yr_Progress не изменяется)."""
  updateSudzYear(input: UpdateSudzYearInput!): SudzYearDetail!

  """Удалить год-вариант (сначала yr_upl_p, затем yr)."""
  deleteSudzYear(yrKey: Int!): Boolean!

  """Создать выгрузку ДЗ."""
  createSudzUpl(input: CreateSudzUplInput!): SudzUplLookup!

  """Добавить выгрузку в год (yr_upl_p)."""
  addSudzYearUpl(yrKey: Int!, uplKey: Int!): SudzYearUpl!

  """Удалить выгрузку из года."""
  removeSudzYearUpl(yrUplPKey: Int!): Boolean!

  """Создать выгрузку платежей."""
  createSudzPmUpl(input: CreateSudzPmUplInput!): SudzPmUplLookup!

  """Связать выгрузку ДЗ с выгрузкой платежей."""
  addSudzPmLink(dbtUplKey: Int!, pmKey: Int!): SudzPmLink!

  """Удалить связь выгрузки ДЗ с платежами."""
  removeSudzPmLink(gPKey: Int!): Boolean!

  """Сохранить куратора / мероприятия / код стройки в yr.yr_CmmGr."""
  updateSudzDebtCollection(input: SudzDebtCollectionInput!): SudzDebtCollectionResult!

  """Дописать строку в yr_Progress (лог формирования документов)."""
  appendSudzYearProgress(yrKey: Int!, line: String!): String!

  """Создать группу комментариев (для yr_CmmGr_New)."""
  createSudzCmmGr(input: CreateSudzCmmGrInput!): SudzCmmGrLookup!

  """Upsert шапки лаунчера загрузки свода (CnInvDbtUplFile) по uplKey."""
  updateSudzDbtUplFile(input: UpdateSudzDbtUplFileInput!): SudzDbtUplFile!

  """Создать лист Excel для выгрузки (CnInvDbtUplFileSh)."""
  createSudzDbtUplFileSh(input: CreateSudzDbtUplFileShInput!): SudzDbtUplFileSh!

  """Обновить лист Excel выгрузки."""
  updateSudzDbtUplFileSh(input: UpdateSudzDbtUplFileShInput!): SudzDbtUplFileSh!

  """Удалить лист Excel выгрузки."""
  deleteSudzDbtUplFileSh(cidufsKey: Int!): Boolean!

  """6 стандартных листов общего свода (если список пуст)."""
  seedSudzDbtUplStandardSheets(uplKey: Int!): [SudzDbtUplFileSh!]!

  """
  Stub-прогон воронки (S61f): шаги-префикс + flLoad; пишет HTML в лог; домен не меняет.
  """
  runSudzDbtUplFunnel(input: RunSudzDbtUplFunnelInput!): SudzDbtUplFunnelResult!
  """Откат apply CnNotLoad по cnMark (удаляет cn → cnNum → cn_s → …)."""
  rollbackSudzCnNotLoad(cnMark: Int!): Int!
  """Создать новый СФ из строки очереди КСДСФ (статус open → created)."""
  createSudzSfFromDouble(ciusKey: Int!): SudzCnInvUplSfDouble!
  """Привязать строку очереди КСДСФ к существующему договору через ags.cnInv."""
  linkSudzSfDoubleToCn(input: LinkSudzSfDoubleInput!): SudzCnInvUplSfDouble!
  """Create слота invDbt + мост + DbtValue из очереди двоящих долгов (A2)."""
  createSudzInvDbtFromDouble(ciudKey: Int!): SudzCnInvUplInvDbtDouble!
  """Link к существующему слоту + мост + DbtValue (A2)."""
  linkSudzInvDbtDouble(input: LinkSudzInvDbtDoubleInput!): SudzCnInvUplInvDbtDouble!
  """
  Split канона на доли одной upl (S77.3). История предыдущих upl на исходном слоте не режется.
  Сумма ttl долей = канон (±0.01). Не через очередь Create/Link.
  """
  splitSudzDbt(input: SplitSudzDbtInput!): SudzDbtSplitResult!
  """
  Merge канонов (мост iddDbt → survivor) или долей на upl (полоса C: снять Value долей, восстановить одну на survivor-слоте).
  Старый Dbt при CANONS не удаляется.
  """
  mergeSudzDbt(input: MergeSudzDbtInput!): SudzDbtMergeResult!
  """Привязать слот invDbt к канону Dbt (S78)."""
  linkSudzInvDbtToDbt(slotKey: Int!, dbtKey: Int!): SudzDbtCanonDetail!
  """Отвязать слот от канона; отказ при наличии DbtValue (S78)."""
  unlinkSudzInvDbtFromDbt(slotKey: Int!): SudzDbtCanonDetail!
  """Создать или обновить DbtValue на слоте канона (S78.4D)."""
  upsertSudzDbtCanonValue(input: UpsertSudzDbtCanonValueInput!): SudzDbtCanonDetail!
  """Удалить DbtValue (чтобы можно было отвязать слот)."""
  deleteSudzDbtCanonValue(valueKey: Int!): SudzDbtCanonDetail!
  """Upsert текста cnInvCmm на DbtValue (группа + тип 1/8). Пустой текст не удаляет."""
  upsertSudzDbtCanonComment(input: UpsertSudzDbtCanonCommentInput!): SudzDbtCanonDetail!
  """Удалить комментарий канона по cnicKey."""
  deleteSudzDbtCanonComment(cmmKey: Int!): SudzDbtCanonDetail!
  """Create/reuse invDbtVar и привязка ciudIdvvKey (ambiguous на экране двоящих)."""
  ensureSudzInvDbtVarForDouble(input: EnsureSudzInvDbtVarForDoubleInput!): SudzCnInvUplInvDbtDouble!
}

"""Год-вариант СУДЗ (yr) с lookup-подписями."""
type SudzYear {
  yrKey: Int!
  yrVariant: String
  baseUpl: Int
  """Ключ ags.yyyy.yKey."""
  yyyy: Int
  cmmGr: Int
  baseUplName: String
  baseUplDate: Date
  cmmGrName: String
  cmmGrDate: Date
  """Рабочая группа новых (yr_CmmGr_New)."""
  cmmGrNew: Int
  cmmGrNewName: String
  cmmGrNewDate: Date
  """Календарный год из ags.yyyy.yyyy."""
  yyyyValue: Int
  """HTML-лог хода (только чтение)."""
  progress: String
}

"""Карточка года с выгрузками."""
type SudzYearDetail {
  year: SudzYear!
  upls: [SudzYearUpl!]!
}

"""Выгрузка в составе года (yr_upl_p)."""
type SudzYearUpl {
  yrUplPKey: Int!
  yrKey: Int!
  uplKey: Int!
  uplName: String
  uplDate: Date
  uplStatusOnDate: Date
  pmLinks: [SudzPmLink!]!
}

"""Связь выгрузки ДЗ с выгрузкой платежей (cn_inv_dbt_upl_g_p)."""
type SudzPmLink {
  gPKey: Int!
  dbtUpl: Int!
  pmKey: Int!
  pmName: String
  pmDate: Date
  dbtUplName: String
  dbtUplDate: Date
}

"""Lookup выгрузки ДЗ."""
type SudzUplLookup {
  uplKey: Int!
  uplName: String
  uplDate: Date
  uplStatusOnDate: Date
}

"""Lookup группы комментариев."""
type SudzCmmGrLookup {
  cmmGrKey: Int!
  name: String
  date: Date
}

"""Lookup календарного года (ags.yyyy)."""
type SudzYyyyLookup {
  yKey: Int!
  yyyy: Int!
}

"""Lookup выгрузки платежей."""
type SudzPmUplLookup {
  pmKey: Int!
  name: String
  date: Date
}

"""Вход создания год-варианта."""
input CreateSudzYearInput {
  variant: String!
  yKey: Int!
  cmmGrKey: Int
  """Существующая базовая выгрузка (взаимоисключающе с newUpl*)."""
  baseUplKey: Int
  newUplName: String
  newUplDate: Date
  newUplStatusOnDate: Date
}

"""Вход обновления год-варианта."""
input UpdateSudzYearInput {
  yrKey: Int!
  variant: String!
  baseUplKey: Int!
  yKey: Int!
  cmmGrKey: Int
  cmmGrNewKey: Int
}

"""Вход создания группы комментариев."""
input CreateSudzCmmGrInput {
  name: String!
  date: Date!
}

"""Вход создания выгрузки ДЗ."""
input CreateSudzUplInput {
  name: String!
  uplDate: Date
  statusOnDate: Date!
}

"""Вход создания выгрузки платежей."""
input CreateSudzPmUplInput {
  name: String
  date: Date!
}

"""Долг портфеля (витрина Rslt)."""
type SudzRsltDebt {
  dbtKey: Int!
  accountNum: String
  curator: String
  mery: String
  cstCode: String
  cstName: String
  """Куратор из yr_CmmGr_New (cur_new)."""
  curatorNew: String
  """Мероприятия из yr_CmmGr_New (mery_new)."""
  meryNew: String
  """Код стройки из yr_CmmGr_New (cstAgPn_new)."""
  cstCodeNew: String
  periods: [SudzRsltPeriod!]!
}

"""Срез долга на дату выгрузки."""
type SudzRsltPeriod {
  uplKey: Int!
  uplDate: Date
  asOf: Date
  invNumEnum: String
  idNum: Int
  cnNumEnum: String
  csoCnDate: Date
  orgIdValueL: Float
  itn: String
  ctptOrg: String
  maturity: Date
  ttl: Float
  overd: Float
  cstAgPnCode: String
  cstAgPnName: String
  agOrg: String
  pogasheno: Float
}

"""Строка итогового документа D644."""
type SudzD644Row {
  dbtKey: Int!
  accountNum: Int
  agent: String
  orgId: Float
  itn: String
  counterpart: String
  contract: String
  contractDate: Date
  invoice: String
  dateStart: Date
  maturityBase: Date
  ttlBase: Float
  overdBase: Float
  maturityCurr: Date
  overdCurr: Float
  repaid: Float
  cstCode: String
  cstName: String
  comment644: String
  baseUplDate: Date
  currUplDate: Date
  baseUpl: Int
  currUpl: Int
}

"""Результат годового свода."""
type SudzSvodResult {
  accounts: [SudzSvodAccount!]!
  total: SudzSvodTotal
}

"""Строка свода по счёту ГК."""
type SudzSvodAccount {
  accountNum: Int!
  accountName: String
  overdBase: Float
  repaid: Float
  overdCurr: Float
  repaidPct: Float
}

"""Итог ВСЕГО."""
type SudzSvodTotal {
  overdBase: Float
  repaid: Float
  overdCurr: Float
  repaidPct: Float
}

"""Вход сохранения сбора по долгу."""
input SudzDebtCollectionInput {
  yr: Int!
  dbtKey: Int!
  curator: String
  mery: String
  """Код стройки (cstAgPn.cstapIpgPnN). Пусто — снять привязку."""
  cstCode: String
}

"""Результат сохранения сбора."""
type SudzDebtCollectionResult {
  dbtKey: Int!
  curator: String
  mery: String
  cstCode: String
  cstName: String
  cmmGr: Int!
}

"""Карточка лаунчера загрузки свода (экран C / 0069)."""
type SudzDbtUplLauncher {
  upl: SudzUplLookup!
  """Null, если строки CnInvDbtUplFile ещё нет."""
  file: SudzDbtUplFile
  sheets: [SudzDbtUplFileSh!]!
  invDoubles: [SudzDbtUplInvDouble!]!
  """Очередь КСДСФ (CnInvUplSfDouble) по uplKey."""
  sfDoubles: [SudzCnInvUplSfDouble!]!
  """Очередь двоящих долгов СФ (CnInvUplInvDbtDouble) по uplKey."""
  invDbtDoubles: [SudzCnInvUplInvDbtDouble!]!
  """Очередь P1 multi-Dbt (CnInvUplDbtP1) по uplKey."""
  dbtP1: [SudzCnInvUplDbtP1!]!
}

"""Шапка лаунчера (CnInvDbtUplFile)."""
type SudzDbtUplFile {
  cidufKey: Int!
  cidufUpload: Int!
  cidufPath: String!
  cidufFlLoad: Boolean!
  cidufFlTbl: Boolean!
  cidufLoadingProgress: String
}

"""Лист файла (CnInvDbtUplFileSh)."""
type SudzDbtUplFileSh {
  cidufsKey: Int!
  cidufsFile: Int!
  cidufsSheet: String!
  """Ключ ags.accnt.account_key."""
  cidufsAccount: Int!
  """Номер счёта ГК (ags.accnt.account_num)."""
  accountNum: Int
  cidufsTest: Boolean!
}

"""Очередь неоднозначных СФ (CnInvDbtUplFileInvDouble)."""
type SudzDbtUplInvDouble {
  cidufiKey: Int!
  cidufiCiduf: Int
  cidufiCnNnn: Int
  cidufiCnNum: String
  cidufiCnKey: Int
  cidufiInvNnn: Int
  cidufiInvNum: String
  cidufiInvNumCount: String
}

"""Общая очередь КСДСФ (CnInvUplSfDouble)."""
type SudzCnInvUplSfDouble {
  ciusKey: Int!
  ciusCidut: Int
  ciusCiput: Int
  ciusDbtFile: Int
  ciusPmtFile: Int
  ciusUnloadKey: Int
  ciusDbtTblCnInvRow: Int
  ciusPmtTblCnInvRow: Int
  ciusCnKey: Int
  ciusCnNum: String
  ciusInvNum: String
  ciusInvNumCount: Int
  ciusStatus: String!
  ciusStatusAt: DateTime
  ciusCreatedInvKey: Int
}

"""Очередь двоящих задолженностей СФ (CnInvUplInvDbtDouble)."""
type SudzCnInvUplInvDbtDouble {
  ciudKey: Int!
  ciudCidut: Int!
  ciudDbtFile: Int
  ciudUnloadKey: Int!
  ciudIKey: Int
  ciudCnNum: String
  ciudInvNum: String
  ciudDebt: Float
  ciudIdvvKey: Int
  ciudReason: String
  """Текстовый канал сообщений (v1: блок [queue.build] при rebuild)."""
  ciudReasonDetail: String
  ciudStatus: String!
  ciudStatusAt: DateTime
  ciudCreatedIdKey: Int
}

"""Очередь кандидатов P1 multi-Dbt (CnInvUplDbtP1)."""
type SudzCnInvUplDbtP1 {
  cip1Key: Int!
  cip1UnloadKey: Int!
  cip1BaseUpl: Int!
  cip1DbtFile: Int
  cip1DbtKey: Int!
  cip1BaseSlotKey: Int!
  cip1BaseIKey: Int
  cip1BaseCnNum: String
  cip1BaseInvNum: String
  cip1MatchSum: Float!
  cip1SumKind: String!
  cip1CandCidut: Int
  cip1CandIKey: Int
  cip1CandCnNum: String
  cip1CandInvNum: String
  cip1CandDebt: Float
  cip1Reason: String!
  cip1ReasonDetail: String
  cip1Status: String!
  cip1StatusAt: DateTime
  cip1LinkedSlotKey: Int
}

"""Вход ручной привязки строки КСДСФ к существующему inv/cn."""
input LinkSudzSfDoubleInput {
  ciusKey: Int!
  invKey: Int!
  cnKey: Int!
}

"""Привязка строки очереди двоящих долгов к существующему слоту invDbt."""
input LinkSudzInvDbtDoubleInput {
  ciudKey: Int!
  idKey: Int!
}

"""Create/reuse invDbtVar для строки очереди двоящих."""
input EnsureSudzInvDbtVarForDoubleInput {
  ciudKey: Int!
  idvvCnNum: Int!
  idvvInvNum: Int!
  idvvAccnt: Int!
  idvvCnSOrg: Int!
}

"""Режим Merge (S77.3)."""
enum SudzDbtMergeMode {
  """N канонов → один Dbt; Value на слотах не трогаем (113→112)."""
  CANONS
  """Доли на одной СФ: на upl снова одна Value на survivor-слоте (полоса C)."""
  SHARES_ON_UPL
}

"""Одна доля Split."""
input SplitSudzDbtPartInput {
  ttl: Float!
  overd: Float
  varKey: Int
  note: String
  dateStart: Date
  dateMaturity: Date
  docBase: String
  """Строка очереди КСДД; после Split статус created."""
  ciudKey: Int
}

"""Вход Split канона на доли одной upl."""
input SplitSudzDbtInput {
  dbtKey: Int!
  sourceSlotKey: Int!
  uplKey: Int!
  parts: [SplitSudzDbtPartInput!]!
}

"""Созданная доля Split."""
type SudzDbtSplitPartResult {
  slotKey: Int!
  varKey: Int!
  valueKey: Int!
  ttl: Float!
}

"""Результат Split."""
type SudzDbtSplitResult {
  dbtKey: Int!
  sourceSlotKey: Int!
  uplKey: Int!
  removedSourceValue: Boolean!
  parts: [SudzDbtSplitPartResult!]!
}

"""Вход Merge."""
input MergeSudzDbtInput {
  mode: SudzDbtMergeMode!
  survivorDbtKey: Int!
  slotKeys: [Int!]!
  survivorSlotKey: Int
  uplKey: Int
}

"""Результат Merge."""
type SudzDbtMergeResult {
  survivorDbtKey: Int!
  mode: SudzDbtMergeMode!
  updatedBridges: Int!
  removedShareValues: Int!
  restoredValueKey: Int
}

"""Вход поиска канонов Dbt (S78). Все поля опциональны; нужен ≥1 критерий."""
input SudzDbtCanonSearchInput {
  cnNum: String
  invNum: String
  orgBuirg: Int
  orgName: String
  csoDate: Date
  idNum: Int
  dbtKey: Int
  limit: Int
}

"""Кандидат канона в поиске."""
type SudzDbtCanonCandidate {
  dbtKey: Int!
  slotCount: Int!
  cnNum: String
  invNum: String
  orgBuirg: Int
  orgName: String
  csoDate: Date
  idNumMin: Int
  idNumMax: Int
  lastTtlSum: Float
}

"""Карточка канона со слотами."""
type SudzDbtCanonDetail {
  dbtKey: Int!
  slots: [SudzDbtCanonSlot!]!
  """Год-варианты, пересекающие upl карточки (для выбора yr_CmmGr / New)."""
  cmmYears: [SudzDbtCanonCmmYear!]!
}

"""Слот канона."""
type SudzDbtCanonSlot {
  slotKey: Int!
  iKey: Int!
  idNum: Int!
  varKey: Int
  cnNum: String
  invNum: String
  orgBuirg: Int
  csoDate: Date
  accountKey: Int
  accountNum: Int
  values: [SudzDbtCanonValue!]!
}

"""Value на слоте."""
type SudzDbtCanonValue {
  valueKey: Int!
  uplKey: Int!
  ttl: Float
  overd: Float
  uplName: String
  uplDate: Date
  uplStatusOnDate: Date
  comments: [SudzDbtCanonComment!]!
}

"""Комментарий cnInvCmm на DbtValue (типы 1 и 8)."""
type SudzDbtCanonComment {
  cmmKey: Int!
  valueKey: Int!
  cmmGrKey: Int!
  cmmGrName: String
  """official | new | other"""
  groupKind: String!
  cnicType: Int!
  text: String
}

"""Год-вариант с группами комментариев для карточки канона."""
type SudzDbtCanonCmmYear {
  yrKey: Int!
  yrVariant: String
  cmmGr: Int
  cmmGrName: String
  cmmGrNew: Int
  cmmGrNewName: String
  uplKeys: [Int!]!
}

"""Вход upsert комментария на DbtValue."""
input UpsertSudzDbtCanonCommentInput {
  valueKey: Int!
  cmmGrKey: Int!
  """1 мероприятия, 8 куратор."""
  cnicType: Int!
  """Пустая строка сохраняет ряд."""
  text: String!
}

"""Вход upsert DbtValue на слоте канона."""
input UpsertSudzDbtCanonValueInput {
  slotKey: Int!
  uplKey: Int!
  ttl: Float!
  overd: Float
  valueKey: Int
}

"""Слот sudz.invDbt (экран двоящих долгов)."""
type SudzInvDbtSlot {
  idKey: Int!
  idInv: Int!
  idNum: Int!
  idNote: String
}

"""Кандидаты FK для create invDbtVar."""
type SudzInvDbtVarCandidates {
  ciudKey: Int!
  iKey: Int
  accountKey: Int
  sides: [SudzInvDbtVarSideCandidate!]!
  cnNums: [SudzInvDbtVarCnNumCandidate!]!
  invNums: [SudzInvDbtVarInvNumCandidate!]!
}

type SudzInvDbtVarSideCandidate {
  cnKey: Int!
  cnSOrgKey: Int!
  csoCnDate: Date
}

type SudzInvDbtVarCnNumCandidate {
  cnnKey: Int!
  cnKey: Int!
  cnnNumNull: String
}

type SudzInvDbtVarInvNumCandidate {
  inKey: Int!
  inInv: Int!
  inNumNull: String
}

"""Excel-кандидат (строка CnInvDbtUplTbl)."""
type SudzSfDoubleExcelCandidate {
  cidutKey: Int!
  findDbtNum: Int
  cidutAccount: Int
  """Номер счёта ГК (ags.accnt.account_num), как в дереве слотов."""
  cidutAccntNum: Int
  cidutCntrPrtNum: Int
  cidutCntrPrtName: String
  cidutCntrPrtITN: String
  cidutCnName: String
  cidutCnDate: Date
  cidutCnInv: String
  cidutCnInvName: String
  cidutFormtnDate: Date
  cidutMatrtyDate: Date
  cidutDebt: Float
  cidutDebtOverdue: Float
  cidutDoc: String
  cidutLink: String
  cidutSheet: Int
  cidutSheetNum: Int
  cidutUnloadKey: Int
}

"""Существующий СФ в домене с тем же номером."""
type SudzSfDoubleDomainMatch {
  invKey: Int!
  invNum: String
  invNumKey: Int
  invEntered: DateTime
  ciKey: Int
  cnKey: Int
  cnNum: String
}

"""Совпадение суммы в старой структуре (ags.cn_inv_dbt)."""
type SudzSfDoubleOldSumMatch {
  cidKey: Int!
  number: Int
  dbtTtl: Float
  dbtOverd: Float
  debtType: String
  uplKey: Int
  ciaKey: Int
  """Имя карточки cnInvAccnt (сегм. 20 / M4)."""
  ciaName: String
}

"""Совпадение суммы в новой структуре (sudz.DbtValue, M2: якорь invDbt)."""
type SudzSfDoubleNewSumMatch {
  dvKey: Int!
  dvTtl: Float
  dvOverd: Float
  dvUpl: Int
  """Слот invDbt (dvInvDbt)."""
  dvInvDbt: Int
  """Канон Dbt через invDbtDbt; null, если канона ещё нет."""
  dbtKey: Int
}

"""Пара списков совпадений по сумме для вкладки «Суммы»."""
type SudzSfDoubleSumMatches {
  oldMatches: [SudzSfDoubleOldSumMatch!]!
  newMatches: [SudzSfDoubleNewSumMatch!]!
}

"""Ключ совпадения для выбора строки на экране КСДСФ."""
type SudzSfDoubleHintItem {
  zone: String!
  pickKey: String!
  pickValue: Int!
  invKey: Int
  cnKey: Int
  cnNum: String
  matchBy: String!
  label: String
}

"""Секция подсказки (СФ / суммы old / суммы new)."""
type SudzSfDoubleHintSection {
  """yes | no | unknown | na"""
  status: String!
  message: String!
  totalCount: Int!
  items: [SudzSfDoubleHintItem!]!
}

"""Три зоны подсказок по исполнителю Excel."""
type SudzSfDoubleHints {
  sfByNum: SudzSfDoubleHintSection!
  sumsOld: SudzSfDoubleHintSection!
  sumsNew: SudzSfDoubleHintSection!
}

"""Советник КСДСФ для панели «Сообщения» ([советник])."""
type SudzSfDoubleAdvice {
  messageText: String!
  confidence: String
  action: String
  recommendInvKey: Int
  recommendCnKey: Int
}

"""Советник КСДД для панели «Сообщения» ([advisor])."""
type SudzInvDbtDoubleAdvice {
  messageText: String!
  confidence: String
  action: String
  recommendIdKey: Int
  recommendVarKey: Int
  recommendDbtKey: Int
  recommendUplKey: Int
  splitParts: [SudzDbtSplitPart!]
}

"""Доля Split (ответ советника / зеркало input)."""
type SudzDbtSplitPart {
  ttl: Float!
  overd: Float
  varKey: Int
  note: String
  dateStart: Date
  dateMaturity: Date
  docBase: String
  ciudKey: Int
}

"""Точка ряда DbtValue по слоту."""
type SudzInvDbtTimelinePoint {
  uplKey: Int
  statusDate: Date
  ttl: Float
  overdue: Float
  source: String
  varKey: Int
}

"""Временной ряд одного слота invDbt."""
type SudzInvDbtSlotTimeline {
  idKey: Int!
  idNum: Int!
  ciaName: String
  varKey: Int
  accnt: Int
  excelAnchor: Float
  excelStatusDate: Date
  points: [SudzInvDbtTimelinePoint!]!
}

"""Вход upsert шапки лаунчера."""
input UpdateSudzDbtUplFileInput {
  uplKey: Int!
  """Null — не менять путь (при insert — пустая строка)."""
  path: String
  """Null — не менять (при insert — false)."""
  flLoad: Boolean
  """Null — не менять (при insert — false)."""
  flTbl: Boolean
}

"""Вход создания листа CnInvDbtUplFileSh."""
input CreateSudzDbtUplFileShInput {
  uplKey: Int!
  sheet: String!
  """Номер счёта ГК (606012 …), не account_key."""
  accountNum: Int!
  test: Boolean!
}

"""Вход обновления листа CnInvDbtUplFileSh."""
input UpdateSudzDbtUplFileShInput {
  cidufsKey: Int!
  sheet: String
  accountNum: Int
  test: Boolean
}

"""Вход stub/реального прогона воронки."""
input RunSudzDbtUplFunnelInput {
  uplKey: Int!
  """Контекст портфеля года (yr.yr_key) для diff base→curr."""
  yrKey: Int!
  """Префикс цепочки stepId (S61f)."""
  steps: [String!]!
  flLoad: Boolean!
}

"""Результат прогона воронки."""
type SudzDbtUplFunnelResult {
  launcher: SudzDbtUplLauncher!
  ranSteps: [String!]!
  """true — тело шагов ещё заглушка."""
  stub: Boolean!
}
