schema {
  query: Query
  mutation: Mutation
}

scalar UUID

type Query {
  organizations: [Organization!]!
  organization(id: Int!): Organization
  """Идентификаторы org_id (БУиРГ type=1, ИНН type=2) организации."""
  organizationIds(organizationId: Int!): [OrganizationId!]!
  """Варианты наименований ags.ogNmF."""
  organizationNameVariants(organizationId: Int!): [OrganizationNameVariant!]!
  agents: [Agent!]!
  agent(id: Int!): Agent
  organizationAgents(organizationId: Int!): [Agent!]!
  investmentChains(name: String, year: Int): [InvestmentChain!]!
  investmentChain(id: Int!): InvestmentChain
  investmentChainRelations(chainId: Int!): [InvestmentChainRelation!]!
  stNetworks: [StNetwork!]!
  investmentPrograms: [InvestmentProgramLookup!]!
  investmentPlanGroups: [InvestmentPlanGroupLookup!]!
  """Схемы структуры ИПГ (stNet.stnType = 1)."""
  stIpgNetworks: [StIpgNetwork!]!
  stIpgNetwork(id: Int!): StIpgNetwork
  """Дерево схемы через ags.fnSt (root по умолчанию = stnRoot)."""
  stIpgNetworkTree(stNetKey: Int!, rootKey: Int): [StIpgTreeNode!]!
  """Все имена узла (aliases для ловли из Excel)."""
  stIpgNodeNames(stiKey: Int!): [StIpgNm!]!
  """Полные карточки ИП (Leaves), не lookup."""
  investmentProgramsFull(year: Int, ogKey: Int, name: String): [IpgFull!]!
  investmentProgramFull(id: Int!): IpgFull
  investmentProgramPoints(ipgKey: Int!): [IpgPn!]!
  investmentProgramPoint(id: Int!): IpgPn
  ipgPnStructure(ipgpKey: Int!): [IpgStPn!]!
  """Справочник схем реализации пункта (ags.ipgSh)."""
  ipgSchemes: [IpgSh!]!
  """Сессии загрузки Excel годовой ИП (ags.impIpgLoad) под карточкой ipg."""
  impIpgLoads(ipgKey: Int!): [ImpIpgLoad!]!
  impIpgLoad(id: Int!): ImpIpgLoad
  """Строки staging ags.impIpg; structureOnly=true — только ПТСФ (разделы)."""
  impIpgRows(loadKey: Int!, structureOnly: Boolean): [ImpIpgRow!]!
  impIpgRow(id: Int!): ImpIpgRow
  """Сверка ПТСФ сессии со схемой stNet (без записи stiKey)."""
  impIpgStructureReconcile(loadKey: Int!, stNetKey: Int!): ImpIpgReconcileResult!
  """Gate загрузки пунктов: ПТСФ open=0 на ipg.ipgStRlSh (§3.2.1)."""
  impIpgPointsGate(loadKey: Int!): ImpIpgPointsGateResult!
  """Наследование stiKey листьев от родителя-раздела; дыры без записи (§3.2.2)."""
  impIpgStiInherit(loadKey: Int!): ImpIpgStiInheritResult!
  """Резолв ipgpSh: prev-IP / else 4 / дубли→схемы; без записи (§3.2.3)."""
  impIpgShResolve(loadKey: Int!, previousIpgKey: Int): ImpIpgShResolveResult!
}

type Mutation {
  createStIpgNetwork(name: String!, rootKey: Int!): StIpgNetwork!
  renameStIpgNetwork(id: Int!, name: String!): StIpgNetwork!
  """Клон схемы: новый stNet + копия stNetPn (узлы shared)."""
  cloneStIpgNetwork(sourceId: Int!, newName: String!): StIpgNetwork!
  createStIpgChildNode(stNetKey: Int!, parentKey: Int!, name: String!, stpnNum: Int): StIpgTreeNode!
  renameStIpgNode(stiKey: Int!, name: String!): Boolean!
  """Добавить alias-имя узла (не затирая существующие)."""
  addStIpgNodeName(stiKey: Int!, name: String!): StIpgNm!
  """Привязать существующий узел как ребёнка parent в схеме."""
  attachStIpgEdge(stNetKey: Int!, parentKey: Int!, childKey: Int!, stpnNum: Int): Boolean!
  """Перенос ребёнка в схеме (detach+attach)."""
  moveStIpgEdge(stNetKey: Int!, childKey: Int!, fromParentKey: Int!, toParentKey: Int!, stpnNum: Int): Boolean!
  detachStIpgEdge(stNetKey: Int!, parentKey: Int!, childKey: Int!): Boolean!
  deleteStIpgNode(stNetKey: Int!, stiKey: Int!): Boolean!
  """Leaves: карточка ИП / пункты / привязка к stiKey."""
  createInvestmentProgram(input: CreateIpgInput!): IpgFull!
  updateInvestmentProgram(id: Int!, input: UpdateIpgInput!): IpgFull!
  createIpgPn(input: CreateIpgPnInput!): IpgPn!
  updateIpgPn(id: Int!, input: UpdateIpgPnInput!): IpgPn!
  """Удаление пункта: cascade ipgStPn; forbid при UtPl/Lim."""
  deleteIpgPn(id: Int!): Boolean!
  addIpgPnStructure(ipgpKey: Int!, stiKey: Int!): IpgStPn!
  removeIpgPnStructure(ipgspKey: Int!): Boolean!
  setIpgPnStructure(ipgpKey: Int!, stiKeys: [Int!]!): [IpgStPn!]!
  """Цепи: шапка ipgCh + членство ipgChRl (без mastering / ipgChRl_2606)."""
  createInvestmentChain(input: CreateInvestmentChainInput!): InvestmentChain!
  updateInvestmentChain(id: Int!, input: UpdateInvestmentChainInput!): InvestmentChain!
  deleteInvestmentChain(id: Int!): Boolean!
  addIpgToChain(input: AddIpgToChainInput!): InvestmentChainRelation!
  updateChainRelation(id: Int!, input: UpdateChainRelationInput!): InvestmentChainRelation!
  removeIpgFromChain(id: Int!): Boolean!
  """Каркас загрузки годовой ИП (impIpgLoad / impIpg), C2 §3.1.6.1."""
  createImpIpgLoad(input: CreateImpIpgLoadInput!): ImpIpgLoad!
  updateImpIpgLoad(id: Int!, input: UpdateImpIpgLoadInput!): ImpIpgLoad!
  deleteImpIpgLoad(id: Int!): Boolean!
  createImpIpgRow(input: CreateImpIpgRowInput!): ImpIpgRow!
  updateImpIpgRow(id: Int!, input: UpdateImpIpgRowInput!): ImpIpgRow!
  deleteImpIpgRow(id: Int!): Boolean!
  """Очистить staging сессии (перед повторным парсом); cascade parent null."""
  clearImpIpgRows(loadKey: Int!): Int!
  """Разбор основного листа приложения Excel → ags.impIpg (разделы S + листья L)."""
  parseImpIpgLoad(id: Int!, filePath: String): ImpIpgParseResult!
  """Сверка ПТСФ → stiKey; persistMatches=true записывает уникальные совпадения."""
  reconcileImpIpgStructure(loadKey: Int!, stNetKey: Int!, persistMatches: Boolean): ImpIpgReconcileResult!
  """Ручной map раздела ПТСФ на stiKey (clearStiKey сбрасывает)."""
  mapImpIpgRowSti(id: Int!, stiKey: Int, clearStiKey: Boolean): ImpIpgRow!
  """Bulk apply листьев → ipgPn+ipgStPn (§3.2.4). dryRun=true — только валидация."""
  applyImpIpgPoints(loadKey: Int!, previousIpgKey: Int, dryRun: Boolean): ImpIpgPointsApplyResult!
  createOrganization(input: OgCreateRequest!): Organization!
  """Создать og + опционально org_id type=1 (БУиРГ) и/или type=2 (ИНН). ИНН только в org_id."""
  createOrganizationWithIds(input: CreateOrganizationWithIdsInput!): Organization!
  """Привязать БУиРГ и/или ИНН(+КПП) к существующей организации."""
  attachOrganizationIds(input: AttachOrganizationIdsInput!): [OrganizationId!]!
  updateOrganizationId(input: UpdateOrganizationIdInput!): OrganizationId!
  createOrganizationNameVariant(input: CreateOgNmFInput!): OrganizationNameVariant!
  updateOrganizationNameVariant(input: UpdateOgNmFInput!): OrganizationNameVariant!
  deleteOrganizationNameVariant(onfKey: Int!): Boolean!
  updateOrganization(id: Int!, input: OgUpdateRequest!): Organization!
  deleteOrganization(id: Int!): Boolean!
  createAgent(input: OgAgCreateRequest!): Agent!
  updateAgent(id: Int!, input: OgAgUpdateRequest!): Agent!
  deleteAgent(id: Int!): Boolean!
}

type Organization {
  ogKey: Int
  ogName: String!
  ogOfficialName: String!
  ogFullName: String
  ogDescription: String
  inn: Float
  kpp: Float
  ogrn: Float
  okpo: Float
  oe: Int
  registrationTaxType: String!
}

"""Строка ags.org_id."""
type OrganizationId {
  orgIdKey: Int!
  org: Int!
  orgIdType: Int!
  orgIdValueL: Int
  orgIdValueT: String
  orgIdValueTExt: String
}

type Agent {
  ogAgKey: Int
  code: String!
  organizationKey: Int!
  legacyOid: UUID
}

input OgCreateRequest {
  ogName: String!
  ogOfficialName: String!
  ogFullName: String
  ogDescription: String
  inn: Float
  kpp: Float
  ogrn: Float
  okpo: Float
  oe: Int
  registrationTaxType: String!
}

"""Создание og + org_id. ИНН — только в org_id type=2."""
input CreateOrganizationWithIdsInput {
  ogName: String!
  ogOfficialName: String!
  ogFullName: String
  ogDescription: String
  registrationTaxType: String!
  buirg: Int
  itn: String
  """КПП в org_id_value_t_ext."""
  itnExt: String
}

"""Привязка идентификаторов к существующей og."""
input AttachOrganizationIdsInput {
  ogKey: Int!
  buirg: Int
  itn: String
  """КПП / расширение текстового ключа (org_id_value_t_ext)."""
  itnExt: String
}

input UpdateOrganizationIdInput {
  orgIdKey: Int!
  org: Int!
  orgIdType: Int!
  orgIdValueL: Int
  orgIdValueT: String
  orgIdValueTExt: String
}

"""Вариант наименования ags.ogNmF («разные имена для ловли»)."""
type OrganizationNameVariant {
  onfKey: Int!
  onfOg: Int!
  onfName: String!
  onfNameExt: String
  onfStart: Date
  onfEnd: Date
}

input CreateOgNmFInput {
  onfOg: Int!
  onfName: String!
  onfNameExt: String
  onfStart: Date
  onfEnd: Date
}

input UpdateOgNmFInput {
  onfKey: Int!
  onfOg: Int!
  onfName: String!
  onfNameExt: String
  onfStart: Date
  onfEnd: Date
}

input OgUpdateRequest {
  ogName: String!
  ogOfficialName: String!
  ogFullName: String
  ogDescription: String
  inn: Float
  kpp: Float
  ogrn: Float
  okpo: Float
  oe: Int
  registrationTaxType: String!
}

input OgAgCreateRequest {
  code: String!
  organizationKey: Int!
  legacyOid: UUID
}

input OgAgUpdateRequest {
  code: String!
  organizationKey: Int!
  legacyOid: UUID
}

type InvestmentChain {
  chainKey: Int
  name: String!
  stNetKey: Int
  stNetName: String
  latestIpgKey: Int
  year: Int
}

type InvestmentChainRelation {
  relationKey: Int
  chainKey: Int
  investmentProgramKey: Int
  investmentProgramName: String
  planGroupKey: Int
  planGroupName: String
}

"""Пишется только name: stNet/late/year на noM6 — computed (fnIpgChain*)."""
input CreateInvestmentChainInput {
  name: String!
}

input UpdateInvestmentChainInput {
  name: String!
}

input AddIpgToChainInput {
  chainKey: Int!
  investmentProgramKey: Int!
  planGroupKey: Int
}

input UpdateChainRelationInput {
  investmentProgramKey: Int!
  planGroupKey: Int
}

type StNetwork {
  stNetKey: Int!
  name: String!
}

type StIpgNetwork {
  stNetKey: Int!
  stNetType: Int!
  name: String!
  rootKey: Int!
}

type StIpgTreeNode {
  childKey: Int!
  parentKey: Int
  stpnNum: Int
  pnLevel: Int
  stNum: String
  name: String
  stRelKey: Int
  stNetPnKey: Int
}

"""Имя/alias узла структуры ИПГ (ags.stIpgNm)."""
type StIpgNm {
  stinKey: Int!
  stiKey: Int!
  name: String!
}

"""Полная карточка ИП (ags.ipg). ipgStRlSh → stNet."""
type IpgFull {
  ipgKey: Int!
  ipgOg: Int!
  ogName: String
  ipgNm: String!
  """Ключ года (ags.yyyy.yKey)."""
  ipgYy: Int!
  """Календарный год из yyyy."""
  year: Int
  ipgNum: Int!
  ipgStr: Date!
  ipgEnd: Date
  ipgRepl: Int
  ipgStRlSh: Int!
  stNetName: String
  ipgYyYear: Int
}

type IpgPn {
  ipgpKey: Int!
  ipgpIpg: Int!
  ipgpNum: Int
  ipgpCstAgPn: Int!
  """Код САК (cstapIpgPnN)."""
  cstAgPnCode: String
  """Наименование стройки (cstapCstName)."""
  cstAgPnCstName: String
  """Агент (cstapOgName)."""
  cstAgPnOgName: String
  ipgpSmTtl: Float
  ipgpSmWrk: Float
  ipgpSmEqu: Float
  ipgpSmOth: Float
  ipgpSmAgFee: Float
  ipgpCostAdjust: Float
  ipgpSmReserv: Float
  ipgpTskCms: String
  ipgpSh: Int!
  ipgpShName: String
}

type IpgStPn {
  ipgspKey: Int!
  ipgspPn: Int!
  ipgspSt: Int!
  stName: String
}

type IpgSh {
  ipgsKey: Int!
  ipgsNm: String!
}

input CreateIpgInput {
  ipgOg: Int!
  ipgNm: String!
  ipgYy: Int!
  ipgNum: Int!
  ipgStr: Date!
  ipgEnd: Date
  ipgRepl: Int
  """FK на stNet (обязателен)."""
  ipgStRlSh: Int!
  ipgYyYear: Int
}

input UpdateIpgInput {
  ipgNm: String!
  ipgYy: Int!
  ipgNum: Int!
  ipgStr: Date!
  ipgEnd: Date
  ipgRepl: Int
  ipgStRlSh: Int!
  ipgYyYear: Int
}

input CreateIpgPnInput {
  ipgpIpg: Int!
  ipgpNum: Int
  ipgpCstAgPn: Int!
  """Схема реализации; на noM6 есть 1..3 (исторический default 4 — если есть в ipgSh)."""
  ipgpSh: Int!
  ipgpSmTtl: Float
  ipgpSmWrk: Float
  ipgpSmEqu: Float
  ipgpSmOth: Float
  ipgpSmAgFee: Float
  ipgpCostAdjust: Float
  ipgpSmReserv: Float
  ipgpTskCms: String
}

input UpdateIpgPnInput {
  ipgpNum: Int
  ipgpCstAgPn: Int!
  ipgpSh: Int!
  ipgpSmTtl: Float
  ipgpSmWrk: Float
  ipgpSmEqu: Float
  ipgpSmOth: Float
  ipgpSmAgFee: Float
  ipgpCostAdjust: Float
  ipgpSmReserv: Float
  ipgpTskCms: String
}

type InvestmentProgramLookup {
  ipgKey: Int!
  name: String!
}

type InvestmentPlanGroupLookup {
  planGroupKey: Int!
  name: String!
}

"""Сессия загрузки Excel годовой ИП (ags.impIpgLoad)."""
type ImpIpgLoad {
  id: Int!
  ipgKey: Int!
  name: String!
  filePath: String
  note: String
  """ISO local datetime."""
  created: String
}

"""Строка staging разбора Excel (ags.impIpg). rowKind: S=раздел, L=стройка."""
type ImpIpgRow {
  id: Int!
  loadKey: Int!
  rowNo: Int!
  rowKind: String!
  text: String
  parentKey: Int
  stiKey: Int
  ctx: String
}

input CreateImpIpgLoadInput {
  ipgKey: Int!
  name: String!
  filePath: String
  note: String
}

input UpdateImpIpgLoadInput {
  name: String!
  filePath: String
  note: String
}

input CreateImpIpgRowInput {
  loadKey: Int!
  rowNo: Int!
  """S | L"""
  rowKind: String!
  text: String
  parentKey: Int
  stiKey: Int
  ctx: String
}

input UpdateImpIpgRowInput {
  rowNo: Int
  rowKind: String
  text: String
  parentKey: Int
  stiKey: Int
  """Сбросить stiKey в NULL (игнорировать stiKey)."""
  clearStiKey: Boolean
  ctx: String
}

"""Итог парсера Excel годовой ИП → staging."""
type ImpIpgParseResult {
  loadKey: Int!
  sheetName: String!
  filePath: String!
  sectionCount: Int!
  leafCount: Int!
  totalRows: Int!
}

"""Строка ПТСФ после сверки со схемой."""
type ImpIpgReconcileRow {
  rowId: Int!
  rowNo: Int!
  text: String
  stiKey: Int
  """MATCHED | NEEDS_ALIAS | PATH_MISMATCH | HOMONYM | UNMATCHED | MANUAL"""
  status: String!
  candidateStiKeys: [Int!]!
  pathMatched: Boolean!
  nameInPool: Boolean!
  """Готово к «+» / можно убрать из вкладки «не сопоставлено»."""
  closed: Boolean!
}

"""Итог сверки ПТСФ."""
type ImpIpgReconcileResult {
  loadKey: Int!
  stNetKey: Int!
  matched: Int!
  open: Int!
  rows: [ImpIpgReconcileRow!]!
}

"""Gate перед bulk пунктов: ready=true только при закрытом ПТСФ и заданном ipgStRlSh."""
type ImpIpgPointsGateResult {
  loadKey: Int!
  ipgKey: Int!
  stNetKey: Int
  sectionCount: Int!
  openCount: Int!
  ready: Boolean!
  errors: [String!]!
  openRowIds: [Int!]!
}

"""Лист без резолвленного sti родителя (дыра §3.2.2)."""
type ImpIpgStiInheritLeaf {
  rowId: Int!
  rowNo: Int!
  text: String
  parentKey: Int
  resolvedStiKey: Int
  """NO_PARENT | PARENT_MISSING | PARENT_NOT_SECTION | PARENT_STI_MISSING"""
  holeReason: String
}

"""Превью наследования sti L←S: ready при leafCount>0 и holeCount=0; без записи staging/домена."""
type ImpIpgStiInheritResult {
  loadKey: Int!
  ipgKey: Int!
  leafCount: Int!
  readyCount: Int!
  holeCount: Int!
  ready: Boolean!
  errors: [String!]!
  holes: [ImpIpgStiInheritLeaf!]!
}

"""Лист с ошибкой или (в будущем) деталью резолва ipgpSh."""
type ImpIpgShResolveLeaf {
  rowId: Int!
  rowNo: Int!
  text: String
  cstAgPnCode: String
  resolvedSh: Int
  """FROM_PREV | DEFAULT_4 | FREE_POOL"""
  source: String
  """MISSING_CSTAGPN | NO_FREE_SCHEMES | UNIQUE_CSTAGPN_SH"""
  errorReason: String
}

"""Итог apply пунктов из staging (§3.2.4 / §3.2.7 partial)."""
type ImpIpgPointsApplyResult {
  loadKey: Int!
  ipgKey: Int!
  previousIpgKey: Int
  dryRun: Boolean!
  leafCount: Int!
  appliedCount: Int!
  """Уже были в домене (unique) — не ошибка (§3.2.7)."""
  skippedAlreadyCount: Int!
  ready: Boolean!
  errors: [String!]!
  problemRowIds: [Int!]!
  createdPnKeys: [Int!]!
}

"""Превью ipgpSh (§5.2): ready при errorCount=0; без записи в домен."""
type ImpIpgShResolveResult {
  loadKey: Int!
  ipgKey: Int!
  previousIpgKey: Int
  leafCount: Int!
  resolvedCount: Int!
  errorCount: Int!
  fromPrevCount: Int!
  default4Count: Int!
  freePoolCount: Int!
  ready: Boolean!
  errors: [String!]!
  problemLeaves: [ImpIpgShResolveLeaf!]!
}
